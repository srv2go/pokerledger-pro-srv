generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USER ───────────────────────────────────────────────
model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String?
  pin             String?        // hashed 4-6 digit PIN for quick unlock
  phone           String?
  displayName     String
  avatarUrl       String?
  role            UserRole       @default(PLAYER)
  subscription    Subscription   @default(FREE)
  whatsappEnabled Boolean        @default(true)
  rememberToken   String?        // long-lived token for auto-login
  preferences     Json?
  isVerified      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  hostedGames        Game[]          @relation("GameHost")
  gameParticipations GamePlayer[]
  transactions       Transaction[]
  notifications      Notification[]
  inboxMessages      InboxMessage[]
  rollingBalances    RollingBalance[] @relation("PlayerBalance")
  hostBalances       RollingBalance[] @relation("HostBalance")
  managedHosts       User[]          @relation("AdminHosts")
  managedBy          User?           @relation("AdminHosts", fields: [managedById], references: [id])
  managedById        String?

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HOST
  PLAYER
}

enum Subscription {
  FREE
  PREMIUM
}

// ─── GAME ───────────────────────────────────────────────
model Game {
  id              String      @id @default(uuid())
  hostId          String
  name            String
  gameType        GameType    @default(TEXAS_HOLDEM)
  status          GameStatus  @default(SCHEDULED)
  location        String?
  startTime       DateTime
  endTime         DateTime?
  buyInAmount     Decimal     @db.Decimal(10,2)
  blindsSmall     Decimal?    @db.Decimal(10,2)
  blindsBig       Decimal?    @db.Decimal(10,2)
  anteAmount      Decimal?    @db.Decimal(10,2)
  rakePercentage  Decimal     @default(0) @db.Decimal(5,2)
  rebuyPolicy     RebuyPolicy @default(UNLIMITED)
  maxRebuys       Int?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  host            User           @relation("GameHost", fields: [hostId], references: [id])
  players         GamePlayer[]
  transactions    Transaction[]
  gameFloats      GameFloat[]
  expenses        Expense[]

  @@map("games")
}

enum GameType {
  TEXAS_HOLDEM
  OMAHA
  OMAHA_HI_LO
  MIXED
}

enum GameStatus {
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum RebuyPolicy {
  UNLIMITED
  CAPPED
  TIME_LIMITED
  NONE
}

// ─── GAME PLAYER (supports rejoin after cashout) ────────
model GamePlayer {
  id              String        @id @default(uuid())
  gameId          String
  playerId        String
  initialBuyIn    Decimal       @db.Decimal(10,2)
  totalInvested   Decimal       @default(0) @db.Decimal(10,2)
  cashOut         Decimal?      @db.Decimal(10,2)
  finalBalance    Decimal?      @db.Decimal(10,2)
  status          PlayerStatus  @default(ACTIVE)
  seatNumber      Int?
  session         Int           @default(1)  // increments on rejoin
  joinedAt        DateTime      @default(now())
  leftAt          DateTime?

  game            Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player          User          @relation(fields: [playerId], references: [id])

  @@unique([gameId, playerId])
  @@map("game_players")
}

enum PlayerStatus {
  INVITED
  CONFIRMED
  ACTIVE
  SITTING_OUT
  ELIMINATED
  CASHED_OUT
}

// ─── TRANSACTION ────────────────────────────────────────
model Transaction {
  id              String           @id @default(uuid())
  gameId          String
  playerId        String
  type            TransactionType
  amount          Decimal          @db.Decimal(10,2)
  paymentMethod   PaymentMethod    @default(CASH)
  paymentStatus   PaymentStatus    @default(COMPLETED)
  session         Int              @default(1) // links to player session
  notes           String?
  createdAt       DateTime         @default(now())

  game            Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player          User             @relation(fields: [playerId], references: [id])

  @@map("transactions")
}

enum TransactionType {
  BUY_IN
  RE_BUY
  TOP_UP
  CASH_OUT
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  VENMO
  PAYPAL
  ZELLE
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  DISPUTED
  REFUNDED
}

// ─── GAME FLOAT (host buffer/escrow chips with dealer) ──
model GameFloat {
  id        String   @id @default(uuid())
  gameId    String
  amount    Decimal  @db.Decimal(10,2)
  notes     String?
  createdAt DateTime @default(now())

  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("game_floats")
}

// ─── EXPENSES (food, rent, dealer, misc) ────────────────
model Expense {
  id        String      @id @default(uuid())
  gameId    String
  category  ExpenseType
  amount    Decimal     @db.Decimal(10,2)
  notes     String?
  createdAt DateTime    @default(now())

  game      Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

enum ExpenseType {
  FOOD
  RENT
  DEALER
  MISC
}

// ─── ROLLING BALANCE (cross-game tally per player-host) ─
model RollingBalance {
  id          String   @id @default(uuid())
  playerId    String
  hostId      String
  totalBuyIn  Decimal  @default(0) @db.Decimal(10,2)
  totalCashOut Decimal @default(0) @db.Decimal(10,2)
  balance     Decimal  @default(0) @db.Decimal(10,2)  // negative = owes host
  lastGameId  String?
  updatedAt   DateTime @updatedAt

  player      User     @relation("PlayerBalance", fields: [playerId], references: [id])
  host        User     @relation("HostBalance", fields: [hostId], references: [id])

  @@unique([playerId, hostId])
  @@map("rolling_balances")
}

// ─── NOTIFICATION ───────────────────────────────────────
model Notification {
  id          String              @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  externalId  String?
  metadata    Json?
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  user        User                @relation(fields: [userId], references: [id])

  @@map("notifications")
}

enum NotificationType {
  GAME_INVITATION
  BUY_IN
  RE_BUY
  TOP_UP
  CASH_OUT
  GAME_STARTING
  GAME_ENDED
  BALANCE_REMINDER
  GAME_SUMMARY
  SETTLEMENT_REMINDER
}

enum NotificationChannel {
  IN_APP
  SMS
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ─── INBOX MESSAGE (for premium in-app messaging) ──────
model InboxMessage {
  id        String   @id @default(uuid())
  userId    String
  gameId    String?
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@map("inbox_messages")
}
